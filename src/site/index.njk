---
layout: layouts/base.njk
---

<div class="papa-wrapper">

  {# ==========================================================================
     HERO SECTION
     ========================================================================== #}
  <section class="section section--hero" id="top">
    <div class="section__inner">
      <div class="hero-content animate-slide-up">
        <p class="hero-greeting">Hello, I'm</p>
        <h1 class="hero-title">Amey Ambade</h1>
        <p class="hero-tagline lead">Lead Data Scientist. Curious mind. Lifelong learner.</p>
        <p class="hero-description">
          I explore the intersection of data, technology, and human curiosity.
          This is my corner of the internet where I write about technical challenges,
          share opinions on the industry, and document my journey through new hobbies.
        </p>
        <div class="hero-cta">
          <a href="#blog" class="btn btn--primary">Read the Blog</a>
          <a href="#connect" class="btn btn--secondary">Get in Touch</a>
        </div>
      </div>
    </div>
  </section>

  {# ==========================================================================
     BLOG PREVIEW SECTION
     ========================================================================== #}
  <section class="section section--alt" id="blog">
    <div class="section__inner">
      <header class="section__header animate-slide-up">
        <h2 class="section__title">Latest Writing</h2>
        <p class="section__description">
          Thoughts on data science, technology, industry opinions, and adventures in new hobbies.
        </p>
      </header>

      <div class="card-grid card-grid--auto stagger-container">
        {# Blog Post 1 - Placeholder #}
        <article class="section-card animate-slide-up">
          <div class="card__header">
            <span class="card__eyebrow tag tag--primary">Technical</span>
            <h3 class="card__title">Welcome to My New Site</h3>
          </div>
          <div class="card__content">
            <p>An introduction to what you'll find here and what I'm hoping to share with the world.</p>
          </div>
          <div class="card__footer">
            <span class="timestamp">Coming Soon</span>
          </div>
        </article>

        {# Blog Post 2 - Placeholder #}
        <article class="section-card animate-slide-up">
          <div class="card__header">
            <span class="card__eyebrow tag tag--secondary">Opinions</span>
            <h3 class="card__title">The State of Data Science in 2024</h3>
          </div>
          <div class="card__content">
            <p>My perspective on where the field is heading and what skills matter most.</p>
          </div>
          <div class="card__footer">
            <span class="timestamp">Coming Soon</span>
          </div>
        </article>

        {# Blog Post 3 - Placeholder #}
        <article class="section-card animate-slide-up">
          <div class="card__header">
            <span class="card__eyebrow tag">Hobbies</span>
            <h3 class="card__title">Trying Something New</h3>
          </div>
          <div class="card__content">
            <p>Documenting my first attempt at a hobby from my bucket list.</p>
          </div>
          <div class="card__footer">
            <span class="timestamp">Coming Soon</span>
          </div>
        </article>
      </div>

      <div class="section__cta mt-8 animate-fade">
        <a href="/blog/" class="external-link">View all posts</a>
      </div>
    </div>
  </section>

